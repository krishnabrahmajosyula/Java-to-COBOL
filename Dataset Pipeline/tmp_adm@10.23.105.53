{"text": " lottery number is \"\n       DISPLAY lotteryDigit1_main\n       DISPLAY lotteryDigit2_main\n      * Check the guess\n       IF guessDigit1_main = lotteryDigit1_main  AND  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Exact match: you win $10,000\"\n       ELSE\n       IF guessDigit2_main = lotteryDigit1_main  AND  guessDigit1_main = lotteryDigit2_main\n       DISPLAY \"Match all digits: you win $3,000\"\n       ELSE\n       IF guessDigit1_main = lotteryDigit1_main  OR  guessDigit1_main = lotteryDigit2_main  OR  guessDigit2_main = lotteryDigit1_main  OR  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Match one digit: you win $1,000\"\n       ELSE\n       DISPLAY \"Sorry, no match\"\n       END-IF\n       END-IF\n       END-IF\n       EXIT.\n\n\n"}
{"text": "1_main\n       DISPLAY lotteryDigit2_main\n      * Check the guess\n       IF guessDigit1_main = lotteryDigit1_main  AND  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Exact match: you win $10,000\"\n       ELSE\n       IF guessDigit2_main = lotteryDigit1_main  AND  guessDigit1_main = lotteryDigit2_main\n       DISPLAY \"Match all digits: you win $3,000\"\n       ELSE\n       IF guessDigit1_main = lotteryDigit1_main  OR  guessDigit1_main = lotteryDigit2_main  OR  guessDigit2_main = lotteryDigit1_main  OR  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Match one digit: you win $1,000\"\n       ELSE\n       DISPLAY \"Sorry, no match\"\n       END-IF\n       END-IF\n       END-IF\n       EXIT.\n\n\n"}
{"text": "_main\n      * Check the guess\n       IF guessDigit1_main = lotteryDigit1_main  AND  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Exact match: you win $10,000\"\n       ELSE\n       IF guessDigit2_main = lotteryDigit1_main  AND  guessDigit1_main = lotteryDigit2_main\n       DISPLAY \"Match all digits: you win $3,000\"\n       ELSE\n       IF guessDigit1_main = lotteryDigit1_main  OR  guessDigit1_main = lotteryDigit2_main  OR  guessDigit2_main = lotteryDigit1_main  OR  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Match one digit: you win $1,000\"\n       ELSE\n       DISPLAY \"Sorry, no match\"\n       END-IF\n       END-IF\n       END-IF\n       EXIT.\n\n\n"}
{"text": "<|fim_prefix|>       IF guessDigit1_main = lotteryDigit1_main  AND  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Exact match: you win $10,000\"\n       ELSE\n       IF guessDigit2_main = lotteryDigit1_main  AND  guessDigit1_main = lotteryDigit2_main\n       DISPLAY \"Match all digits: you win $3,000\"\n       ELSE\n       IF guessDigit1_main<|fim_suffix|>2_main = lotteryDigit1_main  OR  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Match one digit: you win $1,000\"\n       ELSE\n       DISPLAY \"Sorry, no match\"\n       END-IF\n       END-IF\n       END-IF\n       EXIT.\n\n\n<|fim_middle|> = lotteryDigit1_main  OR  guessDigit1_main = lotteryDigit2_main  OR  guessDigit"}
{"text": "<|fim_prefix|>Digit1_main  AND  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Exact match: you win $10,000\"\n       ELSE\n       IF guessDigit2_main = lotteryDigit1_main  AND  guessDigit1_main = lotteryDigit2_main\n       DISPLAY \"Match all digits: you win $3,000\"\n       ELSE\n       IF guessDigit1_main = lotteryDigit1_main  OR  guess<|fim_suffix|>: you win $1,000\"\n       ELSE\n       DISPLAY \"Sorry, no match\"\n       END-IF\n       END-IF\n       END-IF\n       EXIT.\n\n\n<|fim_middle|>Digit1_main = lotteryDigit2_main  OR  guessDigit2_main = lotteryDigit1_main  OR  guessDigit2_main = lotteryDigit2_main\n       DISPLAY \"Match one digit"}
