{"text": "Product BY 10 GIVING n2_getProduct\n       MOVE gpwsd(b_getProduct, n1_getProduct, l2_getProduct) TO pwsd_getProduct\n      * ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE"}
{"text": "<|fim_prefix|>2_getProduct\n       MOVE gpwsd(b_getProduct, n1_getProduct, l<|fim_suffix|>)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1<|fim_middle|>2_getProduct) TO pwsd_getProduct\n      * ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT"}
{"text": "d(b_getProduct, n1_getProduct, l2_getProduct) TO pwsd_getProduct\n      * ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd"}
{"text": "Product, l2_getProduct) TO pwsd_getProduct\n      * ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q"}
{"text": " pwsd_getProduct\n      * ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product"}
{"text": " ans = ans +  (pwsd * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd"}
{"text": "<|fim_prefix|>d * power);\n       MOVE getSum(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gp<|fim_suffix|> d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMA<|fim_middle|>wsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gp"}
{"text": "(b_getProduct, ans_getProduct, pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUT"}
{"text": " pwsd_getProduct * power_getProduct) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpws"}
{"text": "<|fim_prefix|>Product) TO ans_getProduct\n       MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT =<|fim_suffix|>_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n      <|fim_middle|> 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n      "}
{"text": " MULTIPLY power_getProduct BY 10 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gp"}
{"text": "<|fim_prefix|>0 GIVING power_getProduct\n       END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR<|fim_suffix|> COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n      <|fim_middle|>  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpws"}
{"text": " END-PERFORM\n       EXIT.\n\n\n       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP"}
{"text": "       gpwsd-PARA.\n       MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpws"}
{"text": "<|fim_prefix|> MOVE 0 TO ans_gpwsd\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUT<|fim_suffix|>0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n      <|fim_middle|>E TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1"}
{"text": "\n       MOVE 1 TO power_gpwsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY "}
{"text": "wsd\n       MOVE 0 TO carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd"}
{"text": "<|fim_prefix|> carry_gpwsd\n       PERFORM UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING<|fim_suffix|> COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n      <|fim_middle|> l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpws"}
{"text": " UNTIL NOT (n1_gpwsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n"}
{"text": "wsd NOT = 0  OR  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum"}
{"text": "  carry_gpwsd NOT = 0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_get"}
{"text": "0)\n       DIVIDE n1_gpwsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power"}
{"text": "<|fim_prefix|>wsd BY 10 GIVING l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpws<|fim_suffix|>       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNT<|fim_middle|>d\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans"}
{"text": "<|fim_prefix|> l1_gpwsd REMAINDER l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpws<|fim_suffix|>\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum ><|fim_middle|>d * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd +"}
{"text": " l1_gpwsd\n       DIVIDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_get"}
{"text": "IDE n1_gpwsd BY 10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry"}
{"text": "10 GIVING n1_gpwsd\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIV"}
{"text": "d\n       COMPUTE TEMP_0 = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 1"}
{"text": " = l1_gpwsd * d2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REM"}
{"text": "2_gpwsd\n       COMPUTE TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n      "}
{"text": " TEMP_1 = TEMP_0 + carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY "}
{"text": " carry_gpwsd\n       COMPUTE product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum"}
{"text": "<|fim_prefix|> product_gpwsd = TEMP_1\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE<|fim_suffix|>IL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n<|fim_middle|> q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PER"}
{"text": "<|fim_prefix|>\n       DIVIDE product_gpwsd BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE<|fim_suffix|>d BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY<|fim_middle|> q_gpwsd TO carry_gpwsd\n       MULTIPLY"}
{"text": " BY b_gpwsd GIVING q_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_get"}
{"text": "_gpwsd\n       DIVIDE product_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_get"}
{"text": "<|fim_prefix|>_gpwsd BY b_gpwsd GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_get<|fim_suffix|>Sum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n<|fim_middle|>Sum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING"}
{"text": " GIVING r_gpwsd REMAINDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP"}
{"text": "INDER r_gpwsd\n       COMPUTE TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum +"}
{"text": "E TEMP_2 = r_gpwsd * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE"}
{"text": "d * power_gpwsd\n       COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 +"}
{"text": "<|fim_prefix|> COMPUTE TEMP_3 = ans_gpwsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIV<|fim_suffix|>_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum<|fim_middle|>IDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 G"}
{"text": "<|fim_prefix|>wsd + TEMP_2\n       COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum<|fim_suffix|>\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n      <|fim_middle|> > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l"}
{"text": "<|fim_prefix|> COMPUTE ans_gpwsd = TEMP_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY <|fim_suffix|> carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_get<|fim_middle|>10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP"}
{"text": "_3\n       MOVE q_gpwsd TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n      "}
{"text": "d TO carry_gpwsd\n       MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_get"}
{"text": " MULTIPLY power_gpwsd BY 10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMA"}
{"text": "10 GIVING power_gpwsd\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE"}
{"text": "\n       END-PERFORM\n       EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum *"}
{"text": "<|fim_prefix|> EXIT.\n\n\n       getSum-PARA.\n       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_get<|fim_suffix|> sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP<|fim_middle|>Sum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n"}
{"text": "       MOVE 0 TO ans_getSum\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 = ans_getSum + TEMP"}
{"text": "\n       MOVE 0 TO carry_getSum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 = ans_getSum + TEMP_6\n       COMPUTE ans_get"}
{"text": "<|fim_prefix|>Sum\n       MOVE 1 TO power_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_<|fim_suffix|>_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 = ans_getSum + TEMP_6\n       COMPUTE ans_getSum = TEMP_7\n       MOVE<|fim_middle|>5\n       DIVIDE sum_getSum BY b_getSum"}
{"text": "<|fim_prefix|>_getSum\n       PERFORM UNTIL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5<|fim_suffix|> + TEMP_6\n       COMPUTE ans_getSum = TEMP_7\n       MOVE q_getSum TO carry_getSum\n<|fim_middle|>\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 ="}
{"text": "<|fim_prefix|>IL NOT (n1_getSum > 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY<|fim_suffix|> TEMP_6\n       COMPUTE ans_getSum = TEMP_7\n       MOVE q_getSum TO carry_getSum\n       MULTIPLY power_getSum BY <|fim_middle|> 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 = ans"}
{"text": " 0  OR  n2_getSum > 0  OR  carry_getSum > 0)\n       DIVIDE n1_getSum BY 10 GIVING l1_getSum REMAINDER l1_getSum\n       DIVIDE n2_getSum BY 10 GIVING l2_getSum REMAINDER l2_getSum\n       DIVIDE n1_getSum BY 10 GIVING n1_getSum\n       DIVIDE n2_getSum BY 10 GIVING n2_getSum\n       COMPUTE TEMP_4 = l1_getSum + l2_getSum\n       COMPUTE TEMP_5 = TEMP_4 + carry_getSum\n       COMPUTE sum_getSum = TEMP_5\n       DIVIDE sum_getSum BY b_getSum GIVING q_getSum\n       DIVIDE sum_getSum BY b_getSum GIVING r_getSum REMAINDER r_getSum\n       COMPUTE TEMP_6 = r_getSum * power_getSum\n       COMPUTE TEMP_7 = ans_getSum + TEMP_6\n       COMPUTE ans_getSum = TEMP_7\n       MOVE q_getSum TO carry_getSum\n       MULTIPLY power_getSum BY 10 GIVING power_getSum\n"}
