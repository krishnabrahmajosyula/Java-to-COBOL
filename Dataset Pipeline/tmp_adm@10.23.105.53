{"text": "-PERFORM\n       EXIT.\n\n\n       rotate-PARA.\n      * write your code here\n       DIVIDE k_rotate BY n_rotate GIVING TEMP_1 REMAINDER TEMP_2\n       COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1"}
{"text": " rotate-PARA.\n      * write your code here\n       DIVIDE k_rotate BY n_rotate GIVING TEMP_1 REMAINDER TEMP_2\n       COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_1"}
{"text": " code here\n       DIVIDE k_rotate BY n_rotate GIVING TEMP_1 REMAINDER TEMP_2\n       COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_11\n       MOVE TEMP_11"}
{"text": " BY n_rotate GIVING TEMP_1 REMAINDER TEMP_2\n       COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_11\n       MOVE TEMP_11 TO right_reverse\n       PERFORM reverse"}
{"text": "<|fim_prefix|> REMAINDER TEMP_2\n       COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate G<|fim_suffix|> reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_11\n       MOVE TEMP_11 TO right_reverse\n       PERFORM reverse-PARA\n       EXIT.\n\n\n       MAIN<|fim_middle|>IVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n"}
{"text": "<|fim_prefix|> COMPUTE TEMP_3 = TEMP_2 + n_rotate\n       DIVIDE TEMP<|fim_suffix|>6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_11\n       MOVE TEMP_11 TO right_reverse\n       PERFORM reverse-PARA\n       EXIT.\n\n\n       MAIN-PARA.\n       COMPUTE n_main<|fim_middle|>_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n      "}
{"text": "2 + n_rotate\n       DIVIDE TEMP_3 BY n_rotate GIVING TEMP_4 REMAINDER TEMP_5\n       COMPUTE k_rotate = TEMP_5\n      * First n-k elements\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       COMPUTE TEMP_7 = n_rotate - k_rotate\n       COMPUTE TEMP_8 = TEMP_7 - 1\n       COMPUTE TEMP_6 = TEMP_8\n       MOVE TEMP_6 TO right_reverse\n       PERFORM reverse-PARA\n      * Last k elements\n       MOVE a_rotate TO arr_reverse\n       SUBTRACT k_rotate FROM n_rotate GIVING TEMP_9\n       MOVE TEMP_9 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_10\n       MOVE TEMP_10 TO right_reverse\n       PERFORM reverse-PARA\n      * Whole array\n       MOVE a_rotate TO arr_reverse\n       MOVE 0 TO left_reverse\n       SUBTRACT 1 FROM n_rotate GIVING TEMP_11\n       MOVE TEMP_11 TO right_reverse\n       PERFORM reverse-PARA\n       EXIT.\n\n\n       MAIN-PARA.\n       COMPUTE n_main = readLine\n       PERFORM V"}
