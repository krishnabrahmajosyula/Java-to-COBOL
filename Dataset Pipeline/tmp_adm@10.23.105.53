{"text": "\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       END-PERFORM\n      * for 2nd Half\n       MOVE 1 TO currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main"}
{"text": "<|fim_prefix|>1 GIVING currRow_main\n       END-PERFORM\n      * for 2nd Half\n       MOVE 1 TO currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n      <|fim_suffix|> GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PER<|fim_middle|> MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM"}
{"text": "<|fim_prefix|> END-PERFORM\n      * for 2nd Half\n       MOVE 1 TO currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE <|fim_suffix|> TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADV<|fim_middle|>1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n"}
{"text": " 2nd Half\n       MOVE 1 TO currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n"}
{"text": "<|fim_prefix|>1 TO currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\"<|fim_suffix|>Row_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n<|fim_middle|> WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - curr"}
{"text": "<|fim_prefix|>E TEMP_0 = n_main - 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING<|fim_suffix|>\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n<|fim_middle|>\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM"}
{"text": " 1\n       PERFORM UNTIL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n"}
{"text": "<|fim_prefix|>IL NOT (currRow_main <= TEMP_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol<|fim_suffix|> \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n<|fim_middle|>_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY"}
{"text": "_0)\n       DISPLAY \"*\" WITH NO ADVANCING\n       MOVE 1 TO currCol_main\n      * for increasing numbers\n       COMPUTE TEMP_1 = n_main - currRow_main\n       PERFORM UNTIL NOT (currCol_main <= TEMP_1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       ADD 1 TO currCol_main\n       COMPUTE TEMP_1 = n_main - currRow_main\n       END-PERFORM\n      * for decreasing numbers\n       SUBTRACT 2 FROM currCol_main GIVING currCol_main\n       PERFORM UNTIL NOT (currCol_main >= 1)\n       DISPLAY currCol_main WITH NO ADVANCING\n       SUBTRACT 1 FROM currCol_main GIVING currCol_main\n       END-PERFORM\n       DISPLAY \"*\"\n       ADD currRow_main TO 1 GIVING currRow_main\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       DISPLAY \"*\" WITH NO ADVANCING\n       EXIT.\n\n\n"}
