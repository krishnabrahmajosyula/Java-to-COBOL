{"text": "       COMPUTE TEMP_0 = RANDOM * 3\n       COMPUTE computer_main = TEMP_0\n      * Prompt the user to enter a number 0, 1, or 2\n       DISPLAY \"scissor (0), rock (1), paper (2): \" WITH NO ADVANCING\n       ACCEPT user_main\n       DISPLAY \"The computer is \" WITH NO ADVANCING\n       EVALUATE computer_main\n       WHEN 0\n       DISPLAY \"scissor.\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock.\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper.\" WITH NO ADVANCING\n       END-EVALUATE\n       DISPLAY \" You are \" WITH NO ADVANCING\n       EVALUATE user_main\n       WHEN 0\n       DISPLAY \"scissor\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper \" WITH NO ADVANCING\n       END-EVALUATE\n      * Display result\n       IF computer_main = user_main\n       DISPLAY \" too. It is a draw\"\n       ELSE\n       IF win_main\n       DISPLAY \". You won"}
{"text": "<|fim_prefix|> * 3\n       COMPUTE computer_main = TEMP_0\n      * Prompt the user to enter a number 0, 1, or 2\n       DISPLAY \"scissor (0), rock (1), paper (2): \" WITH NO ADVANCING\n       ACCEPT user_main\n       DISPLAY \"The computer is \" WITH NO ADVANCING\n       EVALUATE computer_main\n       WHEN 0\n       DISPLAY \"sc<|fim_suffix|>\n       DISPLAY \"paper \" WITH NO ADVANCING\n       END-EVALUATE\n      * Display result\n       IF computer_main = user_main\n       DISPLAY \" too. It is a draw\"\n       ELSE\n       IF win_main\n       DISPLAY \". You won\"\n       ELSE\n       DISPLAY \". You<|fim_middle|>issor.\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock.\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper.\" WITH NO ADVANCING\n       END-EVALUATE\n       DISPLAY \" You are \" WITH NO ADVANCING\n       EVALUATE user_main\n       WHEN 0\n       DISPLAY \"scissor\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock\" WITH NO ADVANCING\n      "}
{"text": "_main = TEMP_0\n      * Prompt the user to enter a number 0, 1, or 2\n       DISPLAY \"scissor (0), rock (1), paper (2): \" WITH NO ADVANCING\n       ACCEPT user_main\n       DISPLAY \"The computer is \" WITH NO ADVANCING\n       EVALUATE computer_main\n       WHEN 0\n       DISPLAY \"scissor.\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock.\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper.\" WITH NO ADVANCING\n       END-EVALUATE\n       DISPLAY \" You are \" WITH NO ADVANCING\n       EVALUATE user_main\n       WHEN 0\n       DISPLAY \"scissor\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper \" WITH NO ADVANCING\n       END-EVALUATE\n      * Display result\n       IF computer_main = user_main\n       DISPLAY \" too. It is a draw\"\n       ELSE\n       IF win_main\n       DISPLAY \". You won\"\n       ELSE\n       DISPLAY \". You lose\"\n       END-IF\n      "}
{"text": " Prompt the user to enter a number 0, 1, or 2\n       DISPLAY \"scissor (0), rock (1), paper (2): \" WITH NO ADVANCING\n       ACCEPT user_main\n       DISPLAY \"The computer is \" WITH NO ADVANCING\n       EVALUATE computer_main\n       WHEN 0\n       DISPLAY \"scissor.\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock.\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper.\" WITH NO ADVANCING\n       END-EVALUATE\n       DISPLAY \" You are \" WITH NO ADVANCING\n       EVALUATE user_main\n       WHEN 0\n       DISPLAY \"scissor\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper \" WITH NO ADVANCING\n       END-EVALUATE\n      * Display result\n       IF computer_main = user_main\n       DISPLAY \" too. It is a draw\"\n       ELSE\n       IF win_main\n       DISPLAY \". You won\"\n       ELSE\n       DISPLAY \". You lose\"\n       END-IF\n       END-IF\n       EXIT.\n\n\n"}
{"text": "<|fim_prefix|>0, 1, or 2\n       DISPLAY \"scissor (0), rock (1), paper (2): \" WITH NO ADVANCING\n       ACCEPT user_main\n       DISPLAY \"The computer is \" WITH NO ADVANCING\n       EVALUATE computer_main\n       WHEN 0\n       DISPLAY \"scissor.\" WITH NO ADVANCING\n       WHEN 1<|fim_suffix|>       DISPLAY \"paper \" WITH NO ADVANCING\n       END-EVALUATE\n      * Display result\n       IF computer_main = user_main\n       DISPLAY \" too. It is a draw\"\n       ELSE\n       IF win_main\n       DISPLAY \". You won\"\n       ELSE\n       DISPLAY \". You lose\"\n       END-IF\n       END-IF\n       EXIT.\n\n\n<|fim_middle|>\n       DISPLAY \"rock.\" WITH NO ADVANCING\n       WHEN 2\n       DISPLAY \"paper.\" WITH NO ADVANCING\n       END-EVALUATE\n       DISPLAY \" You are \" WITH NO ADVANCING\n       EVALUATE user_main\n       WHEN 0\n       DISPLAY \"scissor\" WITH NO ADVANCING\n       WHEN 1\n       DISPLAY \"rock\" WITH NO ADVANCING\n       WHEN 2\n"}
