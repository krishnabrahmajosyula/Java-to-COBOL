{"text": "      * write your code here\n      * Input from ODT is enabled\n      * Declaration & Initialization\n       ACCEPT n_main\n       ACCEPT m_main\n      * INPUT\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n      "}
{"text": " * Input from ODT is enabled\n      * Declaration & Initialization\n       ACCEPT n_main\n       ACCEPT m_main\n      * INPUT\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main"}
{"text": "      * Declaration & Initialization\n       ACCEPT n_main\n       ACCEPT m_main\n      * INPUT\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main\n       DISPLAY TEMP_3\n      "}
{"text": " n_main\n       ACCEPT m_main\n      * INPUT\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main\n       DISPLAY TEMP_3\n       ADD 1 TO counter_main\n      "}
{"text": "      * INPUT\n       COMPUTE TEMP_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main\n       DISPLAY TEMP_3\n       ADD 1 TO counter_main\n       IF counter_main = n_main * m"}
{"text": "_0 = n_main - 1\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE TEMP_1 = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main\n       DISPLAY TEMP_3\n       ADD 1 TO counter_main\n       IF counter_main = n_main * m_main\n       GOBACK\n       END"}
{"text": "<|fim_prefix|>\n       PERFORM VARYING rows_main FROM 0 BY 1 UNTIL NOT (rows_main <= TEMP_0)\n       COMPUTE TEMP_1 = m_main - 1\n       PERFORM<|fim_suffix|> = m_main - 1\n       END-PERFORM\n       COMPUTE TEMP_0 = n_main - 1\n       END-PERFORM\n       MOVE 0 TO counter_main\n       COMPUTE TEMP_2 = n_main * m_main\n       PERFORM UNTIL NOT (counter_main < TEMP_2)\n      * left wall\n       PERFORM VARYING i_main FROM frow_main BY 1 UNTIL NOT (i_main <= lrow_main)\n       MOVE fcol_main TO j_main\n       COMPUTE TEMP_4 = i_main + 1\n       COMPUTE TEMP_3 = j_main\n       DISPLAY TEMP_3\n       ADD 1 TO counter_main\n       IF counter_main = n_main * m_main\n       GOBACK\n       END-IF\n       END-PERFORM<|fim_middle|> VARYING cols_main FROM 0 BY 1 UNTIL NOT (cols_main <= TEMP_1)\n       ACCEPT arr_main(rows_main + 1)[cols_main]\n       COMPUTE"}
