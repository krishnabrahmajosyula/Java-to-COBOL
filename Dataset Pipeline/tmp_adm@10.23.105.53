{"text": "<|fim_prefix|> TEMP_3 REMAINDER TEMP_4\n       COMPUTE direction_main = TEMP_4\n       END-IF\n      * Move One Step\n      <|fim_suffix|>_main GIVING TEMP_6\n       DISPLAY TEMP_6\n       DISPLAY col_main\n       ELSE\n       IF direction_main = 2\n       DISPLAY row_main\n       DISPLAY col_main\n       DISPLAY 1\n       ELSE\n       DISPLAY row_main\n       DISPLAY 1\n       DISPLAY col_main\n       END-IF\n       END-IF\n       END-IF<|fim_middle|> IF direction_main = 0\n       ADD 1 TO col_main\n       ELSE\n       IF direction_main = 1\n       ADD 1 TO row_main\n       ELSE\n       IF direction_main = 2\n       SUBTRACT 1 FROM col_main\n      * North\n       ELSE\n       SUBTRACT 1 FROM row_main\n       END-IF\n       END-IF\n       END-IF\n       END-PERFORM\n      * Report Exit Point\n       IF direction_main = 0\n       DISPLAY row_main\n       SUBTRACT 1 FROM col_main GIVING TEMP_5\n       DISPLAY TEMP_5\n       ELSE\n       IF direction_main = 1\n       SUBTRACT "}
