{"text": " \" WITH NO ADVANCING\n       ACCEPT x1_main\n       ACCEPT y1_main\n       ACCEPT x2_main\n       ACCEPT y2_main\n       ACCEPT x3_main\n       ACCEPT y3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n      "}
{"text": " ACCEPT x1_main\n       ACCEPT y1_main\n       ACCEPT x2_main\n       ACCEPT y2_main\n       ACCEPT x3_main\n       ACCEPT y3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_1"}
{"text": "<|fim_prefix|>1_main\n       ACCEPT x2_main\n       ACCEPT y2_main\n       ACCEPT x3_main\n       ACCEPT y3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUT<|fim_suffix|> TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_1<|fim_middle|>E TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n"}
{"text": "\n       ACCEPT y2_main\n       ACCEPT x3_main\n       ACCEPT y3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_12 = s_main - side1_main"}
{"text": "<|fim_prefix|> ACCEPT x3_main\n       ACCEPT y3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n      <|fim_suffix|> - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_12 = s_main - side1_main\n       COMPUTE TEMP_13<|fim_middle|> COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 ="}
{"text": "<|fim_prefix|>3_main\n      * Compute the area of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side<|fim_suffix|> - side1_main\n       COMPUTE TEMP_13 = s_main * TEMP_12<|fim_middle|>2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_12"}
{"text": "<|fim_prefix|> of a triangle\n       COMPUTE TEMP_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + <|fim_suffix|>8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_12 = s_main - side1_main\n       COMPUTE TEMP_13 = s_main * TEMP_12\n       COMPUTE TEMP_14<|fim_middle|>5\n       COMPUTE side3_main"}
{"text": "<|fim_prefix|>_0 = x1_main - 2\n       COMPUTE TEMP_1 = y1_main - 2\n       COMPUTE TEMP_2 = 0 + 5\n       COMPUTE side1_main = TEMP_2\n       COMPUTE TEMP_3 = x2_main - 2\n       COMPUTE TEMP_4 = y2_main - 2\n       COMPUTE TEMP_5 = 0 + 5\n       COMPUTE side2_main = TEMP_5\n       COMPUTE TEMP_6 = x3_main - 2\n       COMPUTE TEMP<|fim_suffix|> * TEMP_12\n       COMPUTE TEMP_14 = s_main - side2_main\n<|fim_middle|>_7 = y3_main - 2\n       COMPUTE TEMP_8 = 0 + 5\n       COMPUTE side3_main = TEMP_8\n       COMPUTE TEMP_9 = side1_main + side2_main\n       COMPUTE TEMP_10 = TEMP_9 + side3_main\n       COMPUTE TEMP_11 = TEMP_10 / 2\n       COMPUTE s_main = TEMP_11\n       COMPUTE TEMP_12 = s_main - side1_main\n       COMPUTE TEMP_13"}
